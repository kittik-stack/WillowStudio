<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель — WillowStudio</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://static.tildacdn.ink/css/fonts-tildasans.css">
    <link rel="icon" type="image/png" href="/images/icon.png">
    <style>
        .admin-header {
            background: #1a1a1a;
            padding: 20px 0;
            margin-bottom: 40px;
        }
        .admin-header__inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .admin-header__logo {
            color: #fff;
            font-size: 20px;
            font-weight: 700;
        }
        .admin-header__links a {
            color: #fff;
            margin-left: 20px;
            text-decoration: none;
            transition: opacity 0.3s;
        }
        .admin-header__links a:hover {
            opacity: 0.7;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .admin-table th {
            text-align: left;
            padding: 12px 16px;
            background: #f5f5f5;
            font-weight: 600;
        }
        .admin-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }
        .admin-table img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 4px;
        }
        .admin-btn {
            padding: 6px 16px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.3s;
        }
        .admin-btn--danger {
            background: #e74c3c;
            color: #fff;
        }
        .admin-btn--danger:hover {
            background: #c0392b;
        }
        .admin-btn--add {
            background: #1a1a1a;
            color: #fff;
        }
        .admin-btn--add:hover {
            background: #333;
        }
        .admin-empty {
            text-align: center;
            padding: 40px 0;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="admin-header">
        <div class="container admin-header__inner">
            <span class="admin-header__logo">Админ-панель</span>
            <div class="admin-header__links">
                <a href="/">На сайт</a>
                <a href="/admin/logout">Выйти</a>
            </div>
        </div>
    </div>

    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h1>Управление товарами</h1>
            <a href="/admin/add" class="admin-btn admin-btn--add" style="padding: 10px 24px; text-decoration: none;">+ Добавить товар</a>
        </div>

        <% if (products && products.length > 0) { %>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Фото</th>
                        <th>Название</th>
                        <th>Цена</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                        <tr>
                            <td><%= product.id %></td>
                            <td><img src="<%= product.image %>" alt="<%= product.name %>"></td>
                            <td><%= product.name %></td>
                            <td><%= product.price %> BYN</td>
                            <td>
                                <form action="/admin/delete/<%= product.id %>" method="POST" style="display: inline;">
                                    <button type="submit" class="admin-btn admin-btn--danger" onclick="return confirm('Удалить товар «<%= product.name %>»?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="admin-empty">Товаров пока нет. <a href="/admin/add">Добавьте первый</a></div>
        <% } %>
    </div>
</body>
</html>