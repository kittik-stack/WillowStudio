<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> — WillowStudio</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://static.tildacdn.ink/css/fonts-tildasans.css">
    <link rel="icon" type="image/png" href="/images/icon.png">
</head>
<body>

    <%- include('header') %>

    <main class="page-content">
        <section class="product-page">
            <div class="container">
                <a href="/#catalog" class="back-link">← Назад в каталог</a>

                <div class="product-page__inner">
                    <div class="product-page__gallery">
                        <img src="<%= product.image %>" alt="<%= product.name %>" class="product-page__image">
                    </div>
                    <div class="product-page__info">
                        <h1 class="product-page__title"><%= product.name %></h1>
                        <p class="product-page__price"><%= product.price %> BYN</p>
                        <p class="product-page__description"><%= product.fullDescription || product.description %></p>
                        <form action="/cart/add/<%= product.id %>" method="POST">
                            <button type="submit" class="product-page__btn">Добавить в корзину</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <p>© WillowStudio 2026</p>
    </footer>

    <script src="/js/script.js"></script>
</body>
</html>